# ---- Backend ----
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000

# ---- Mercado Pago (Checkout Pro) ----
# Access Token = SECRETO. Vive SOLO acá y en las variables de entorno del
# hosting (Render/Vercel/Railway/etc). Nunca lo pongas en el frontend ni lo
# commitees a git.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Public Key = segura de exponer en el frontend. El backend la sirve vía
# GET /api/public-config para que ningún HTML la tenga hardcodeada.
MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000

# ---- URLs de retorno tras el pago ----
DONATION_SUCCESS_URL=http://localhost:3000/?donation=success
DONATION_FAILURE_URL=http://localhost:3000/?donation=failure

# ---- Supabase ----
# URL y anon key son seguras de exponer al frontend (se sirven vía
# GET /api/public-config, igual que MP_PUBLIC_KEY).
SUPABASE_URL=https://bvxylizvibtfzwyiywdd.supabase.co
SUPABASE_ANON_KEY=changeme-anon-key

# Service role = SECRETO. Bypassea RLS. Solo se usa server-side para
# insertar donaciones y procesar el webhook de Mercado Pago. Nunca en
# el frontend ni commiteado.
SUPABASE_SERVICE_ROLE_KEY=changeme-service-role-key
